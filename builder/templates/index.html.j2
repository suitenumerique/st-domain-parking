{#
  Parking page for a single domain.

  Rendered once per domain at build time, then minified and pre-compressed.
  The output is deliberately self-contained: inline CSS, a data-URI favicon,
  no scripts and no external requests of any kind.
#}
{#- `-%}` and `{%-` so the value is the sentence alone, with no indentation
    from this block leaking into the meta description. #}
{%- set heading -%}
  Ce domaine appartient à la mairie de {{ site.commune_name }} ({{ site.commune_zipcode }}).
{%- endset %}
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ site.domain }}</title>
    <meta name="description" content="{{ heading }}">
    {#-
      This page is meant to be reached by typing the domain, not from search.
      The authoritative record is the Service-Public listing, so stay out of
      the index rather than compete with it. `follow` is left implicit: the
      outbound links are worth following.
    #}
    <meta name="robots" content="noindex">
    <meta name="color-scheme" content="light">
    <link rel="canonical" href="https://www.{{ site.domain }}/">
    {#- The accent dot from the design, inline so the page makes no requests. #}
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Ccircle%20cx='16'%20cy='16'%20r='16'%20fill='%231f5c53'/%3E%3C/svg%3E">

    <style>
      :root {
        --accent: #1f5c53;
        --page: #eef0f2;
        --card: #ffffff;
        --line: #e6e8eb;
        --edge: #d7dade;
        --ink: #1c2429;
        --muted: #5a646c;
        --faint: #7b848c;
        --footnote: #8d959b;
        --hover: #f6f8f9;
        --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas,
          "Liberation Mono", monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 24px 18px 32px;
        background: var(--page);
        color: var(--ink);
        font-family: var(--sans);
        -webkit-text-size-adjust: 100%;
      }

      .card {
        width: 100%;
        max-width: 620px;
        background: var(--card);
        border: 1px solid var(--edge);
        border-radius: 6px;
        box-shadow: 0 2px 10px rgba(30, 40, 50, 0.05);
        overflow: hidden;
      }

      .card-head {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 34px;
        border-bottom: 1px solid var(--line);
      }

      .dot {
        flex: none;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--accent);
      }

      .domain {
        font-size: 15px;
        font-weight: 600;
        line-height: 1.2;
      }

      .tagline {
        font-family: var(--mono);
        font-size: 10.5px;
        color: var(--faint);
      }

      .card-body {
        padding: 34px;
      }

      h1 {
        margin: 0 0 12px;
        font-size: 22px;
        font-weight: 600;
        line-height: 1.45;
      }

      .lede {
        margin: 0 0 26px;
        font-size: 15.5px;
        line-height: 1.65;
        color: var(--muted);
      }

      .lede p {
        margin: 0 0 1em;
      }

      .lede p:last-child {
        margin-bottom: 0;
      }

      .rows {
        border-top: 1px solid var(--line);
      }

      .row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin: 0 -10px;
        padding: 14px 10px;
        border-bottom: 1px solid var(--line);
        text-decoration: none;
        color: inherit;
      }

      .row:last-child {
        border-bottom: 0;
      }

      .row:hover,
      .row:focus-visible {
        background: var(--hover);
      }

      .label {
        font-size: 13.5px;
        color: var(--faint);
      }

      .value {
        font-size: 15.5px;
        font-weight: 600;
        text-align: right;
        overflow-wrap: anywhere;
      }

      .value.accent {
        font-size: 16px;
        color: var(--accent);
      }

      footer {
        max-width: 620px;
        font-size: 12.5px;
        line-height: 1.5;
        color: var(--footnote);
      }

      footer a {
        color: var(--muted);
      }

      @media (max-width: 560px) {
        body {
          justify-content: flex-start;
          padding-top: 18px;
        }

        .card-head {
          padding: 16px 20px;
        }

        .card-body {
          padding: 22px 20px;
        }

        h1 {
          font-size: 18.5px;
          line-height: 1.4;
        }

        .lede {
          margin-bottom: 20px;
          font-size: 14.5px;
          line-height: 1.6;
        }

        .row {
          flex-direction: column;
          align-items: flex-start;
          gap: 2px;
          padding: 13px 10px;
        }

        .label {
          font-size: 12.5px;
        }

        .value {
          font-size: 15px;
          text-align: left;
        }

        footer {
          text-align: center;
        }
      }
    </style>
  </head>

  <body>
    <main class="card">
      <div class="card-head">
        <div class="dot"></div>
        <div>
          <div class="domain">{{ site.domain }}</div>
          <div class="tagline">Nom de domaine communal</div>
        </div>
      </div>

      <div class="card-body">
        <h1>{{ heading }}</h1>

        <div class="lede">
          <p>Cette page fait office de site internet minimal pour la commune.</p>
          <p>
            Vous pouvez vérifier qu'elle en est bien propriétaire sur
            l'<a href="{{ site.service_public_url }}">Annuaire du Service Public</a>.
          </p>
        </div>

        <div class="rows">
          <a class="row" href="mailto:{{ site.email }}">
            <span class="label">Contact de la mairie</span>
            <span class="value accent">{{ site.email }}</span>
          </a>

          <a class="row" href="{{ site.service_public_url }}" rel="noopener">
            <span class="label">Plus d'informations (horaires, adresse, services, ...)</span>
            <span class="value">service-public.gouv.fr &#8599;</span>
          </a>

          <a class="row" href="https://suiteterritoriale.anct.gouv.fr/bienvenue/{{ site.siret }}" rel="noopener">
            <span class="label">Présence numérique</span>
            <span class="value">suiteterritoriale.anct.gouv.fr &#8599;</span>
          </a>
        </div>
      </div>
    </main>

    <footer>
      L'équipe municipale peut modifier ces informations sur
      l'<a href="https://collectivite.fr/">Espace Commune</a>.
    </footer>
  </body>
</html>
