# Static config: the parked set is <OUTPUT_DIR>/<host>/.parked on disk, no reload.
# The set of parked domains is expressed purely on the filesystem. For every
# host it serves, the builder creates <OUTPUT_DIR>/<host>/ containing a
# `.parked` marker; the canonical host additionally gets index.html and its
# pre-compressed variants. Adding or removing a domain is therefore a pure
# file operation — Caddy picks it up on the next request with no reload.
{
	admin off
	# The adapted config carries the S3 credentials in clear text.
	persist_config off
	# Quoted: an empty variable must still expand to one token.
	email "{$ACME_EMAIL}"
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}

	servers {
		# Built without HTTP/2 (nethttpomithttp2): enabling h2 panics at startup.
		protocols h1
		strict_sni_host on
		timeouts {
			# Bounds the TLS handshake too, and the first one waits for issuance.
			read_header 30s
			read_body 5s
		}
		max_header_size 8KiB
		# The load balancer runs in TCP mode, so the client address arrives
		# in a PROXY header, read ahead of the TLS handshake. The header is
		# used from TRUSTED_PROXIES and dropped from any other peer. Unquoted:
		# empty expands to no token, so no peer is trusted.
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow {$TRUSTED_PROXIES}
			}
			tls
		}
		# The same list for X-Forwarded-For, behind a layer-7 proxy.
		trusted_proxies static {$TRUSTED_PROXIES}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}

	# Vendored certmagic-s3, see certmagic-s3/VENDORED.md.
	storage s3 {
		bucket "{$S3_BUCKET}"
		region "{$S3_REGION:us-east-1}"
		endpoint "{$S3_ENDPOINT}"
		access_key "{$S3_ACCESS_KEY}"
		secret_key "{$S3_SECRET_KEY}"
		prefix "{$S3_PREFIX:caddy}"
		# Exactly 32 bytes when set.
		encryption_key "{$S3_ENCRYPTION_KEY}"
	}
	# Each pass reads every stored certificate.
	storage_clean_interval {$STORAGE_CLEAN_INTERVAL:7d}

	# Certificates are issued lazily, but only for parked and helpcenter
	# hosts, and only once their DNS points at PUBLIC_IPS (see permission/).
	# Avoids to burn ACME rate limits.
	on_demand_tls {
		permission parking {
			root {$OUTPUT_DIR:/srv/sites}
			helpcenter_hosts {env.HELPCENTER_REDIRECT_HOSTS}
			helpcenter_target {env.HELPCENTER_REDIRECT_TARGET}
			public_ips {env.PUBLIC_IPS}
		}
	}
}

(common) {
	log {
		output stdout
		format json
	}

	header {
		-Server
		# A visit is one request.
		Connection close
	}

	root * {$OUTPUT_DIR:/srv/sites}

	@parked file /{host}/.parked
	# {env.*} is read at request time, and `in` is an exact match.
	@helpcenter expression `{host} != "" && {env.HELPCENTER_REDIRECT_TARGET} != "" && {host} in {env.HELPCENTER_REDIRECT_HOSTS}.split(" ")`
	@heartbeat path /__lbheartbeat__ /__lbheartbeat__/
	@notget not method GET HEAD
}

# Every redirect is a 302 on purpose: parking is a placeholder. The
# owner is expected to replace with a real site, and a 301 would sit in
# browser caches long after that happened.
http:// {
	import common

	# Straight to the page, rather than through the apex over HTTPS, which
	# costs a TLS handshake only to redirect again.
	@parkedapex {
		file /{host}/.parked
		expression !{host}.startsWith("www.")
	}

	route {
		respond @notget 405

		handle @heartbeat {
			log_skip
			respond 200
		}

		redir @helpcenter {env.HELPCENTER_REDIRECT_TARGET} 302
		redir @parkedapex https://www.{host}/ 302
		redir @parked https://{host}{uri} 302
		respond 404
	}
}

https:// {
	import common

	# Empty is the real ACME issuer, `internal` is Caddy's local CA.
	tls {$CADDY_TLS_ISSUER} {
		on_demand
	}

	handle @notget {
		respond 405
	}

	handle @heartbeat {
		log_skip
		respond 200
	}

	handle @helpcenter {
		redir {env.HELPCENTER_REDIRECT_TARGET} 302
	}

	handle @parked {
		# Caddy would otherwise sort redir ahead of handle.
		route {
			@apex expression !{host}.startsWith("www.")
			redir @apex https://www.{host}/ 302

			# The icon is inline; 204 stops the retries.
			handle /favicon.ico {
				respond 204
			}

			# Served, not redirected, and allowed: a crawler must read the page to see its noindex.
			handle /robots.txt {
				header Content-Type "text/plain; charset=utf-8"
				respond "User-agent: *
Allow: /
" 200
			}

			# A parked domain has exactly one page. Anything else is a
			# temporary redirect back to it rather than a 404, so stale
			# inbound links and old bookmarks still land somewhere useful.
			@subpath not path /
			redir @subpath / 302

			header {
				Cache-Control "public, max-age={$CACHE_MAX_AGE:300}"
				X-Content-Type-Options "nosniff"
				Referrer-Policy "no-referrer"
				Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			}

			rewrite * /{host}/index.html
			file_server {
				precompressed br gzip
			}
		}
	}

	# Unknown host: a certificate may exist from an earlier build, but the
	# domain is no longer parked here.
	handle {
		respond 404
	}
}
